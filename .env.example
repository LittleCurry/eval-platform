# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，不会入库
POSTGRES_USER=eval
POSTGRES_PASSWORD=eval_dev_password
POSTGRES_DB=eval_platform
# Qdrant 无需环境变量；镜像版本固定在 compose.yaml

# ---- worker: embedding (SiliconFlow) ----
# 真实 key 填在 .env, 不要提交; 若密钥曾泄露请到控制台轮换
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 单次批量条数(接口有上限, 建议 16~32)
EMBEDDING_BATCH_SIZE=16

# ---- worker: 生成 / judge (M4 起使用) ----
# 默认走 SiliconFlow 的 DeepSeek: 复用 SILICONFLOW_API_KEY, 无需新凭证。
# 切官方 DeepSeek 只需改下面两行 + 填 DEEPSEEK_API_KEY(代码路径相同):
#   GENERATION_BASE_URL=https://api.deepseek.com
#   GENERATION_MODEL=deepseek-chat
GENERATION_PROVIDER=siliconflow
GENERATION_BASE_URL=https://api.siliconflow.cn/v1
GENERATION_MODEL=deepseek-ai/DeepSeek-V3.2
# 留空则按 GENERATION_API_KEY → SILICONFLOW_API_KEY → DEEPSEEK_API_KEY 的顺序回落
GENERATION_API_KEY=
GENERATION_TEMPERATURE=0
GENERATION_MAX_TOKENS=512
# 上下文按字符截断(会写进 case_results.generation.context_chars, 便于复盘)
GENERATION_MAX_CONTEXT_CHARS=3000
GENERATION_TIMEOUT_SECONDS=60
# 客户端内的传输层重试次数(队列级 item 重试仍是外层兜底)
GENERATION_MAX_RETRIES=2

# 官方 DeepSeek(可选, 仅当 GENERATION_BASE_URL 指向它时才需要)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
