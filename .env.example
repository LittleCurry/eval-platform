# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，不会入库
#
# 三种用法共用这一个文件:
#   1) 只起依赖库(本地开发):  POSTGRES_* 就够
#   2) 起全栈(M7-4 部署):    再填 JWT_SECRET 与 SILICONFLOW_API_KEY
#   3) 前后端在宿主机跑:      另需 PG_HOST/PG_PORT(默认 localhost:5432 已够)

# ---- 数据库 ----
POSTGRES_USER=eval
# 部署到服务器务必改掉这个默认口令
POSTGRES_PASSWORD=eval_dev_password
POSTGRES_DB=eval_platform
# 宿主机映射端口(容器之间一律用服务名 postgres:5432, 不受这里影响)
POSTGRES_HOST_PORT=5432

# ---- Qdrant ----
# 镜像版本固定在 compose.yaml
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ---- 服务端口(M7-4) ----
# 唯一对外入口: nginx 托管的 web(同源代理 /api, 不需要 CORS)
# 注意与本地 `make api-restart` 的 8080 冲突 —— 本地开发时二选一, 或把这里改成 8090
WEB_PORT=8080

# ---- Go API 连接信息(前后端在宿主机跑时才需要; 容器内由 compose 注入) ----
PG_HOST=localhost
PG_PORT=5432
PG_USER=eval
PG_PASSWORD=eval_dev_password
PG_DB=eval_platform
QDRANT_URL=http://localhost:6333

# ---- worker: embedding (SiliconFlow) ----
# 真实 key 填在 .env, 不要提交; 若密钥曾泄露请到控制台轮换
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 单次批量条数(接口有上限, 建议 16~32)
EMBEDDING_BATCH_SIZE=16

# ---- worker: 生成 / judge (M4 起使用) ----
# 这些值有**两个用途**(D14):
#   1. 服务端(Go)把它们当作"提交 run 时未提供字段"的默认值, 并写进配置快照;
#   2. worker 侧作为 fallback(仅在快照缺字段时兜底, 正常运行一律以快照为准)。
# 故改这里只影响**之后新建**的 run, 不会改变已有 run 的语义(它们的参数已固化在快照里)。
# 默认走 SiliconFlow 的 DeepSeek: 复用 SILICONFLOW_API_KEY, 无需新凭证。
# 切官方 DeepSeek 只需改下面两行 + 填 DEEPSEEK_API_KEY(代码路径相同):
#   GENERATION_BASE_URL=https://api.deepseek.com
#   GENERATION_MODEL=deepseek-chat
GENERATION_PROVIDER=siliconflow
GENERATION_BASE_URL=https://api.siliconflow.cn/v1
GENERATION_MODEL=deepseek-ai/DeepSeek-V3.2
GENERATION_PROMPT_ID=qa_zh_v1
# 留空则按 GENERATION_API_KEY → SILICONFLOW_API_KEY → DEEPSEEK_API_KEY 的顺序回落
GENERATION_API_KEY=
GENERATION_TEMPERATURE=0
GENERATION_MAX_TOKENS=512
# 上下文按字符截断(会写进 case_results.generation.context_chars, 便于复盘)
GENERATION_MAX_CONTEXT_CHARS=3000
GENERATION_TIMEOUT_SECONDS=60
# 客户端内的传输层重试次数(队列级 item 重试仍是外层兜底)
GENERATION_MAX_RETRIES=2

# judge (M4-2): claim 级事实核查 + rubric 打分
JUDGE_PROVIDER=siliconflow
JUDGE_BASE_URL=https://api.siliconflow.cn/v1
JUDGE_MODEL=deepseek-ai/DeepSeek-V3.2
JUDGE_CLAIMS_PROMPT_ID=judge_claims_zh_v1
# rubric v2: 断言核查结果驱动 helpfulness(unsupported>0 → 不得高于 2); v1 文件保留不动
JUDGE_RUBRIC_PROMPT_ID=judge_rubric_zh_v2
JUDGE_ENABLE_RUBRIC=true
JUDGE_TEMPERATURE=0
JUDGE_MAX_TOKENS=1024
JUDGE_MAX_CONTEXT_CHARS=3000
JUDGE_MAX_CLAIMS=12
JUDGE_MAX_RETRIES=2
JUDGE_USE_CACHE=true
JUDGE_TIMEOUT_SECONDS=60

# 官方 DeepSeek(可选, 仅当 GENERATION_BASE_URL 指向它时才需要)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 认证 (M7-1) ----
# 生成方式: make jwt-secret  (或 openssl rand -base64 48)
# 留空 / 不配 => API 启动即失败(宁可起不来, 也不要悄悄退化成免登录的 API)
JWT_SECRET=
# token 有效期(小时)。无状态 JWT 撤不回来, 所以别设太长; 停用账号是立即生效的
TOKEN_TTL_HOURS=12
# 仅本地演示: 设为 true 时关闭鉴权(启动日志会大声警告)。生产不要开
AUTH_DISABLED=false
